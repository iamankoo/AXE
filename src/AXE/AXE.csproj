<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AXE</RootNamespace>
    <AssemblyName>AXE</AssemblyName>
    <ApplicationIcon>Assets\axe.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>AXE</Product>
    <Description>Private Floating Browser</Description>
    <Authors>Aniket Raj</Authors>
    <Company>Aniket Raj</Company>
    <Copyright>© Aniket Raj</Copyright>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WebView2Loader is statically linked by the WPF control on x64/arm64. -->
    <WebView2LoaderPreference>Static</WebView2LoaderPreference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\axe.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AXE.Tests" />
  </ItemGroup>

</Project>
