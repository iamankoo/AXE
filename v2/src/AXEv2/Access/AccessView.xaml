<UserControl x:Class="AxeV2.Access.AccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="560"
             MinHeight="420"
             Background="#0B1220"
             FontFamily="Segoe UI"
             Cursor="Arrow">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111C2D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263A56"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A2B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F8CFF"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="#4AC7FF"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1727"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#142238"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PlanCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#122038"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Grid.Row="2"
                                           Text="Access duration"
                                           FontSize="11"
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#15345B"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,4,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="AXE v2"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="PageTitle"
                           Text="Get access to AXE"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="ValidationText"
                           Text=""
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#FFB547"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <Border x:Name="StepBadge"
                    Grid.Column="1"
                    Background="#162A46"
                    BorderBrush="#284D78"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="9,5"
                    VerticalAlignment="Center">
                <TextBlock x:Name="StepText"
                           Text="Step 1 of 2"
                           FontSize="11"
                           Foreground="{StaticResource TextBrush}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">

            <ScrollViewer x:Name="ChoosePage"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="760"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Choose your access"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Select your name and the amount of time you need."
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,22"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Your name"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="NameBox"
                                     Style="{StaticResource FieldStyle}"
                                     AutomationProperties.AutomationId="AccessName"
                                     AutomationProperties.Name="Name"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Choose access duration"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,22,0,10"/>

                    <UniformGrid Columns="3">
                        <RadioButton x:Name="Plan1Hour"
                                     GroupName="AccessPlan"
                                     IsChecked="True"
                                     Content="1 Hour"
                                     Tag="₹149"
                                     Style="{StaticResource PlanCardStyle}"
                                     AutomationProperties.AutomationId="Plan1Hour"/>
                        <RadioButton x:Name="Plan5Hours"
                                     GroupName="AccessPlan"
                                     Content="5 Hours"
                                     Tag="₹199"
                                     Style="{StaticResource PlanCardStyle}"
                                     AutomationProperties.AutomationId="Plan5Hours"/>
                        <RadioButton x:Name="Plan10Hours"
                                     GroupName="AccessPlan"
                                     Content="10 Hours"
                                     Tag="₹299"
                                     Style="{StaticResource PlanCardStyle}"
                                     AutomationProperties.AutomationId="Plan10Hours"/>
                    </UniformGrid>

                    <Button x:Name="ContinueButton"
                            Content="Continue  →"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,22,0,0"
                            AutomationProperties.AutomationId="ContinueAccess"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="OR" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,0"/>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="InvitationButton"
                            Content="Have an invitation code?  ›"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,14,0,0"
                            AutomationProperties.AutomationId="InvitationButton"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PaymentPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="760"
                            HorizontalAlignment="Center">

                    <Button x:Name="PaymentBackButton"
                            Content="←  Back"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="12,7"
                            Margin="0,0,0,14"/>

                    <TextBlock Text="Complete payment"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Scan the QR code, complete the payment, then submit your details."
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,6,0,20"/>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#142A46"
                                    BorderBrush="#284D78"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,18,0">
                                <StackPanel>
                                    <TextBlock Text="Selected plan"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="PaymentPlanText"
                                               Text="1 Hour"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Amount"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="PaymentAmountText"
                                           Text="₹149"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="QrCodeContainer"
                                Width="240"
                                Height="240"
                                Background="White"
                                CornerRadius="12"
                                Padding="10"
                                HorizontalAlignment="Left">
                            <Image x:Name="QrCodeImage"
                                   Stretch="Uniform"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="22,0,0,0"
                                    VerticalAlignment="Top">

                            <TextBlock Text="Payment details"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Text="Amount paid"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,5"/>

                            <TextBox x:Name="AmountPaidBox"
                                     Style="{StaticResource FieldStyle}"
                                     AutomationProperties.AutomationId="AmountPaid"
                                     AutomationProperties.Name="Amount paid"/>

                            <TextBlock Text="UTR / Transaction reference"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,12,0,5"/>

                            <TextBox x:Name="ReferenceBox"
                                     Style="{StaticResource FieldStyle}"
                                     AutomationProperties.AutomationId="PaymentReference"
                                     AutomationProperties.Name="Payment transaction reference"/>

                            <TextBlock x:Name="QrCodeStatusText"
                                       Text="Scan the QR code to pay the selected amount."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Payment screenshot"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Upload the screenshot used for payment verification."
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="ScreenshotPathBox"
                                         Grid.Column="0"
                                         Style="{StaticResource FieldStyle}"
                                         IsReadOnly="True"
                                         Text="No screenshot selected"
                                         AutomationProperties.AutomationId="PaymentScreenshot"/>

                                <Button x:Name="BrowseScreenshotButton"
                                        Grid.Column="1"
                                        Content="Choose file"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        AutomationProperties.AutomationId="ChoosePaymentScreenshot"/>
                            </Grid>

                            <TextBlock Text="JPG, JPEG or PNG • Maximum 10 MB"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="SubmitPaymentButton"
                            Content="Submit payment request  →"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,16,0,8"
                            AutomationProperties.AutomationId="SubmitPayment"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="InvitationPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="600"
                            HorizontalAlignment="Center">

                    <Button x:Name="InvitationBackButton"
                            Content="←  Back"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="12,7"
                            Margin="0,0,0,20"/>

                    <TextBlock Text="Invitation access"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Enter the invitation code you received."
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,22"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Your name"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="InvitationNameBox"
                                     Style="{StaticResource FieldStyle}"
                                     AutomationProperties.AutomationId="InvitationName"/>

                            <TextBlock Text="Access duration"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,5"/>
                            <TextBlock x:Name="InvitationPlanText"
                                       Text="1 Hour — ₹149"
                                       FontSize="14"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Text="Invitation code"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,5"/>
                            <TextBox x:Name="InvitationCodeBox"
                                     Style="{StaticResource FieldStyle}"
                                     AutomationProperties.AutomationId="InvitationCode"/>

                            <Button x:Name="SubmitInvitationButton"
                                    Content="Submit invitation request  →"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,18,0,0"
                                    AutomationProperties.AutomationId="SubmitInvitation"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="PendingPage"
                  Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}"
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Ellipse Width="14"
                                 Height="14"
                                 Fill="#FFB547"
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="Request submitted"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                        <TextBlock Text="Your request is waiting for approval. AXE will update this screen automatically."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   MaxWidth="430"
                                   Margin="0,8,0,18"/>
                        <Button x:Name="CancelButton"
                                Content="Cancel request"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="CancelRequest"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="OfflinePage"
                  Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}"
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="OfflineTitle"
                                   Text="Connection unavailable"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OfflineMessage"
                                   Text="AXE could not verify access with the server."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   MaxWidth="430"
                                   Margin="0,8,0,18"/>
                        <Button x:Name="RetryButton"
                                Content="Retry"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="RetryAccess"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Authorization is verified by the AXE server."
                   FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0"/>
    </Grid>
</UserControl>
