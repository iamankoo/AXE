<Window x:Class="AxeV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AxeV2.Controls"
        xmlns:browser="clr-namespace:AxeV2.Browser"
        Title="AXE v2 — Private Floating Browser"
        Icon="Assets/axe.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        MinWidth="600" MinHeight="360"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1"
            Background="{StaticResource GlassChromeBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="42" />
                <RowDefinition x:Name="NavRow" Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Glass sheen across the chrome rows -->
            <Border Grid.RowSpan="2" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False" />

            <!-- ================= Header: brand + tabs + opacity + caption buttons (drag area) ================= -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand: AXE v2 / AXE - By ARIL Labs -->
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0" ToolTipService.IsEnabled="False">
                    <TextBlock FontSize="17" FontWeight="Black" FontFamily="Segoe UI" LineHeight="18"
                               LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource TextBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF2F7BFF" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
                        </TextBlock.Effect>
                        <Run Text="AX" /><Run Text="E" Foreground="{StaticResource AccentBrush}" /><Run Text=" v2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    </TextBlock>
                    <TextBlock x:Name="CreditText" FontSize="9.5" Margin="0,1,0,0" Foreground="{StaticResource TextMutedBrush}"
                               AutomationProperties.Name="AXE - By ARIL Labs">
                        <Run Text="AXE - By ARIL Labs" />
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="TabControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                    <Border Width="1" Height="18" Margin="0,0,6,0" Background="{StaticResource DividerBrush}" />
                    <Button x:Name="NewTabButton" Style="{StaticResource ChromeButton}" Content="&#xE710;" FontSize="13"
                            Width="30" Height="28" Click="NewTabButton_Click"
                            AutomationProperties.AutomationId="NewTabButton" AutomationProperties.Name="New tab (Ctrl+T)" />
                </StackPanel>

                <!-- Tabs -->
                <ItemsControl x:Name="TabStrip" Grid.Column="2" VerticalAlignment="Bottom" Height="32" Margin="2,0,8,0"
                              ClipToBounds="True" Focusable="False"
                              AutomationProperties.AutomationId="TabStrip" AutomationProperties.Name="Tabs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:TabStripPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type browser:BrowserTab}">
                            <Border x:Name="TabBorder" Height="32" Margin="1,0,1,0" CornerRadius="8,8,0,0"
                                    Background="Transparent" Cursor="Arrow"
                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseUp="Tab_MouseUp"
                                    AutomationProperties.Name="{Binding Title}">
                                <Grid Margin="10,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <TextBlock x:Name="TabGlyph" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="TabFavicon" Source="{Binding Favicon}" Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Ellipse x:Name="TabSpinner" Width="13" Height="13" StrokeThickness="2" Visibility="Collapsed"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF2F7BFF" Offset="0" />
                                                    <GradientStop Color="#002F7BFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Stroke>
                                            <Ellipse.RenderTransform>
                                                <RotateTransform />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMutedBrush}" />
                                    <Button x:Name="TabCloseButton" Grid.Column="2" Style="{StaticResource ChromeButton}"
                                            Content="&#xE711;" FontSize="9" Width="20" Height="20" Margin="4,0,0,0"
                                            Click="TabCloseButton_Click" Visibility="Hidden"
                                            AutomationProperties.Name="Close tab (Ctrl+W)" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                    <Setter TargetName="TabFavicon" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter TargetName="TabSpinner" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="TabFavicon" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="TabGlyph" Property="Visibility" Value="Collapsed" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TabSpinner"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Setter TargetName="TabCloseButton" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource ActiveTabBrush}" />
                                    <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="TabCloseButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="TabBorder" Property="AutomationProperties.ItemStatus" Value="active" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Access time left + transparency: percentage + slider (10% - 100%) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                    <Border x:Name="TimerChip" Visibility="Collapsed" CornerRadius="10" Padding="8,2,9,2" Margin="0,0,12,0"
                            Background="#332F7BFF" BorderBrush="#552F7BFF" BorderThickness="1" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TimerChip">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,1,6,0" />
                            <TextBlock x:Name="TimerText" Text="0:00:00" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" Typography.NumeralAlignment="Tabular"
                                       AutomationProperties.AutomationId="TimerText" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CaptureWarning" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                               FontSize="13" Foreground="#FFFFB547" VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="CaptureWarning_Click"
                               AutomationProperties.Name="Screen-capture exclusion unavailable" />
                    <TextBlock x:Name="OpacityText" Text="25%" Width="34" TextAlignment="Right" FontSize="12.5"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider x:Name="OpacitySlider" Style="{StaticResource AccentSlider}" Width="120" Height="20"
                            Minimum="10" Maximum="100" Value="25" SmallChange="1" LargeChange="10"
                            VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"
                            AutomationProperties.AutomationId="OpacitySlider"
                            AutomationProperties.Name="Opacity" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="MinimizeButton_Click" AutomationProperties.AutomationId="MinimizeButton"
                            AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="MaximizeButton_Click" AutomationProperties.AutomationId="MaximizeButton"
                            AutomationProperties.Name="Maximize" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            Click="CloseButton_Click" AutomationProperties.AutomationId="CloseButton"
                            AutomationProperties.Name="Close" />
                </StackPanel>
            </Grid>

            <!-- ================= Navigation bar ================= -->
            <Grid x:Name="NavBar" Grid.Row="1" Background="Transparent" Margin="10,0,10,0"
                  MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource ChromeButton}" Content="&#xE72B;" FontSize="15"
                            Click="BackButton_Click" IsEnabled="False"
                            AutomationProperties.AutomationId="BackButton" AutomationProperties.Name="Back" />
                    <Button x:Name="ForwardButton" Style="{StaticResource ChromeButton}" Content="&#xE72A;" FontSize="15"
                            Click="ForwardButton_Click" IsEnabled="False" Margin="2,0,0,0"
                            AutomationProperties.AutomationId="ForwardButton" AutomationProperties.Name="Forward" />
                    <Button x:Name="ReloadButton" Style="{StaticResource ChromeButton}" Content="&#xE72C;" FontSize="14"
                            Click="ReloadButton_Click" Margin="2,0,0,0"
                            AutomationProperties.AutomationId="ReloadButton" AutomationProperties.Name="Refresh" />
                    <Border Width="1" Height="18" Margin="10,0,10,0" Background="{StaticResource DividerBrush}" />
                </StackPanel>

                <!-- Address / search pill -->
                <Border x:Name="AddressPill" Grid.Column="1" Height="32" CornerRadius="8" VerticalAlignment="Center"
                        Background="#B3121824" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1"
                        Cursor="IBeam" MouseLeftButtonDown="AddressPill_MouseLeftButtonDown">
                    <Grid Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock x:Name="SearchGlyph" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="FaviconImage" Width="16" Height="16" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <TextBlock x:Name="AddressPlaceholder" Grid.Column="1" Text="Search Google or type a URL"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13.5" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Margin="2,0,0,0" />
                        <TextBox x:Name="AddressBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 SelectionBrush="{StaticResource AccentBrush}" FontSize="13.5" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center" Padding="0" Margin="0"
                                 KeyDown="AddressBox_KeyDown" TextChanged="AddressBox_TextChanged"
                                 GotKeyboardFocus="AddressBox_GotKeyboardFocus" LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                                 PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
                                 AutomationProperties.AutomationId="AddressBox" AutomationProperties.Name="Address and search bar">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="DownloadsButton" Style="{StaticResource ChromeButton}" Content="&#xE896;" FontSize="14"
                            Click="DownloadsButton_Click" Visibility="Collapsed"
                            AutomationProperties.AutomationId="DownloadsButton" AutomationProperties.Name="Downloads" />
                    <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" Content="&#xE713;" FontSize="14"
                            Click="SettingsButton_Click" Margin="2,0,0,0"
                            AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="Settings" />
                </StackPanel>
            </Grid>

            <!-- Thin loading indicator between chrome and page -->
            <Border x:Name="LoadingTrack" Grid.Row="1" Height="2" VerticalAlignment="Bottom" ClipToBounds="True"
                    Visibility="Hidden" IsHitTestVisible="False">
                <Border x:Name="LoadingBar" Width="140" HorizontalAlignment="Left" CornerRadius="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#002F7BFF" Offset="0" />
                            <GradientStop Color="#FF2F7BFF" Offset="0.5" />
                            <GradientStop Color="#002F7BFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LoadingOffset" />
                    </Border.RenderTransform>
                </Border>
            </Border>

            <!-- ================= Browser / Access content ================= -->
            <Grid Grid.Row="2">

                <!-- Existing WebView2 browser surface -->
                <Grid x:Name="BrowserHost"
                    Margin="5,0,5,5"
                    Background="{StaticResource SurfaceBrush}">

                    <!-- Shown instead of the page for setup / engine errors -->
                    <Border x:Name="MessagePanel"
                            Visibility="Collapsed"
                            Background="{StaticResource SurfaceBrush}">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420"
                                    Margin="24">

                            <TextBlock x:Name="MessageTitle"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                    Foreground="{StaticResource TextBrush}"
                                    TextAlignment="Center" />

                            <TextBlock x:Name="MessageBody"
                                    FontSize="13"
                                    TextWrapping="Wrap"
                                    Margin="0,10,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    TextAlignment="Center" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0">

                                <Button x:Name="MessageSecondaryButton"
                                        Style="{StaticResource DialogButton}"
                                        Margin="0,0,8,0"
                                        Click="MessageSecondaryButton_Click" />

                                <Button x:Name="MessagePrimaryButton"
                                        Style="{StaticResource PrimaryDialogButton}"
                                        Click="MessagePrimaryButton_Click" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- Access screen is created by MainWindow because its constructor
                    requires the AccessController dependency. -->
                <ContentControl x:Name="AccessHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Visibility="Visible" />

            </Grid>
        </Grid>
    </Border>
</Window>
